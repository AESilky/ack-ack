.pio_version 0 // only requires PIO version 0

.program uart_rx

; 8n1 UART receiver which handles framing errors and break conditions.
; IN pin 0 and JMP pin are both mapped to the GPIO used as UART RX.

.define PUBLIC BIT_CLK_MULT 20  ; The expected PIO clock multiple of the bit rate
.define MIN_GAP_BITS 13 ; the bits needed for a 'gap'
.fifo rx                ; Use both FIFOs for RX
.in 8 right             ; Shift right, no auto-push

PUBLIC start:
    set x, MIN_GAP_BITS
    wait 1 pin 0 [20/2]         ; Stall until we see a 1 (idle line), then delay 1/2 bit time
idleloop:
    jmp pin, idle_bit
    jmp start                   ; Got a low line, go back to looking for idle line
idle_bit:
    jmp x--, idleloop [20 - 2]  ; 2. Count the 1 [delay 1 bit-time]
    ; We've received enough 1's for the idle period
.wrap_target
    set x, 7                    ; Preload bit counter, then delay until halfway through
    wait 0 pin 0 [20/2]         ; Stall until we see a 0 (start bit), then delay 1/2 bit time
bitloop:                        ; the first data bit (12 cycles incl wait, set).
    in pins, 1                  ; 1. Shift data bit into ISR
    jmp x-- bitloop [20 - 2]    ; 2. Loop 8 times
    jmp pin good_stop           ; 1. Check stop bit (should be high)

framing_error:
    irq wait 0          ; Set IRQ-0 for error and wait for it to be cleared
    ; The system will reset this SM PC back to the start when it handles the interrupt
    ;
good_stop:
    push                        ; 2. no delay before looking for start.
.wrap

.program uart_rx_inv

; Inverted 8n1 UART receiver which handles framing errors and break conditions.
; IN pin 0 and JMP pin are both mapped to the GPIO used as UART RX.

.define PUBLIC BIT_CLK_MULT 20  ; The expected PIO clock multiple of the bit rate
.define MIN_GAP_BITS 13 ; the bits needed for a 'gap'
.fifo rx                ; Use both FIFOs for RX
.in 8 right             ; Shift right, no auto-push

PUBLIC start:
    set x, MIN_GAP_BITS
    wait 0 pin 0 [20/2]         ; Stall until we see a 0 (idle line), then delay 1/2 bit time
idleloop:
    jmp pin, start              ; 1. Got a 1 (not idle)
    jmp x--, idleloop [20 - 2]  ; 2. Count the 0 [delay 1 bit-time]
    ; We've received enough 0's for the idle period
.wrap_target
    set x, 7                    ; Preload bit counter, then delay until halfway through
    wait 1 pin 0 [20/2]         ; Stall until we see a 1 (start bit), then delay 1/2 bit time
bitloop:
    mov y, pins                 ; 1. Read data bit into 'Y' so we can invert it
    mov y, !y                   ; 2. Make the data bit correct
    in y, 1                     ; 3. Read the bit into the ISR
    jmp x-- bitloop [20 - 4]    ; 4. Loop 8 times
    jmp pin framing_error       ; 1. Check stop bit (should be low)
good_stop:
    push                        ; 2. no delay before looking for start.
.wrap
    ;
framing_error:
    irq wait 0          ; Set IRQ-0 for error and wait for it to be cleared
    ; The system will reset this SM PC back to the start when it handles the interrupt

