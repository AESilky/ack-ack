.pio_version 0 // only requires PIO version 0

.program rx_srxl2_uart

; 8n1 UART receiver which handles framing errors and break conditions.
; IN pin 0 and JMP pin are both mapped to the GPIO used as UART RX.

.define PUBLIC BIT_CLK_MULT 20  ; The expected PIO clock multiple of the bit rate
.define MIN_GAP_BITS 13 ; the bits needed for a 'gap'
.fifo rx                ; Use both FIFOs for RX
.in 32 right             ; Shift right, no auto-push

PUBLIC start:
    set x, MIN_GAP_BITS
    wait 1 pin 0 [20/2 - 1]         ; Stall until we see a 1 (idle line), then delay 1/2 bit time
idle_loop:
    jmp pin, idle_bit               ; 1. Idle bit
    jmp start                       ; We got a 0 (non-idle), go back to looking for the idle period
idle_bit:
    jmp x--, idle_loop [20 - 2]     ; 2. Count the idle-bit [delay 1 bit-time]
    ; We've received enough 1's for the idle period
wait_start_bit:
    wait 0 pin 0 [(20/2) - 1]       ; When start-bit is detected, wait 1/2 a bit-time
    set x, 7     [20 - 1]           ; 1. Load bit counter, then delay to middle of data bit
bit_loop:
    in pins, 1                      ; 1. Shift data bit into ISR
    jmp x-- bit_loop [20 - 2]       ; 2. Loop 8 times
    push                            ; 3. Push the data
    jmp pin wait_start_bit          ; Check stop bit (should be high)
    ; Framing error
    irq wait 0                      ; Set IRQ-0 on error and wait for it to be cleared
    ; The system will reset this SM PC back to the start on an error

